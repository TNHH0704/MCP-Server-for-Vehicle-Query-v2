# GitHub Token Configuration
# Copy this file to .env and replace with your actual values
OPENAI_API_KEY=your_github_models_api_key_here

# Database Configuration
# SQL password used in appsettings.json ConnectionStrings via ${SQL_PASSWORD}
SQL_PASSWORD=YOUR_PASSWORD_HERE

# Vehicle API Configuration (required for Docker deployment)
# These can also be configured in appsettings.json
VEHICLE_STATUS_URL=https://your-vehicle-api.com/api/customer/monitor
VEHICLE_API_URL=https://your-vehicle-api.com/api/customer/monitor/vehicles-by-user
WAYPOINT_API_URL=https://your-vehicle-api.com/api/customer/waypoints
AUTH_API_URL=https://your-vehicle-api.com/api/auth/login
LOGIN_ENDPOINT=
REFRESH_TOKEN_ENDPOINT=/refresh
TOKEN_REFRESH_BUFFER=300
MAX_RETRY_ATTEMPTS=2
