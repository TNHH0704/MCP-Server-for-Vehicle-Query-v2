{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Extensions.Http": "Warning",
      "McpVersionVer2.Services.AuthService": "Debug"
    }
  },
  "ApiSettings": {
    "VehicleStatusUrl": "https://your-vehicle-api.com/api/customer/monitor",
    "VehicleApiUrl": "https://your-vehicle-api.com/api/customer/monitor/vehicles-by-user",
    "WaypointApiUrl": "https://your-vehicle-api.com/api/customer/waypoints",
    "AuthApiUrl": "https://your-vehicle-api.com/api/auth/login",
    "LoginEndpoint": "",
    "RefreshTokenEndpoint": "/refresh",
    "TokenRefreshBuffer": 300,
    "MaxRetryAttempts": 2
  },
  "ConversationContext": {
    "WindowSize": 10,
    "MaxTokens": 8000,
    "MaxAgeHours": 1,
    "AutoProvideContext": true,
    "SummaryEnabled": true,
    "SummaryThreshold": 20,
    "SummaryPreserveLastK": 10,
    "SummaryMaxTokens": 512,
    "TokenBudgetForSummary": 6000,
    "MaxSummariesPerSession": 2
  },
  "Audit": {
    "RetentionDays": 7,
    "ConnectionString": "Data Source=./data/audit.db"
  },
  "ConnectionStrings": {
    "ConversationDb": "Data Source=conversation.db",
    "Audit": "Data Source=./data/audit.db"
  },
  "ClientLogging": {
    "Enabled": false,
    "MinLevel": "Warning",
    "AllowedCategories": "AuditLogService,GitHubOpenAIService,SecurityValidationService"
  }
}
